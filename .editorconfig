root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{fs,fsi,fsx}]
# Fantomas reads these
max_line_length = 100
fsharp_multiline_bracket_style = aligned

[*.{cs,csx}]
max_line_length = 120
csharp_style_namespace_declarations = file_scoped:warning

[*.{json,yml,yaml,props,csproj,fsproj,slnx}]
indent_size = 2
